# Variables de Entorno - CRM Multicanal con IA
# Copiar este archivo a .env y completar los valores

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# SUPABASE (Base de Datos)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ==========================================
# WHATSAPP CLOUD API (Meta)
# ==========================================
WHATSAPP_PHONE_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ==========================================
# OPENROUTER (LLM - Recomendado: DeepSeek)
# ==========================================
OPENROUTER_API_KEY=sk-or-your-openrouter-key
LLM_MODEL=deepseek/deepseek-chat-v4-flash
# Modelos alternativos disponibles en OpenRouter:
# - deepseek/deepseek-chat-v4-flash
# - deepseek/deepseek-chat-v3-0324
# - openai/gpt-4o-mini
# - anthropic/claude-3.5-haiku
# - google/gemini-flash-1.5

# ==========================================
# ELEVENLABS (TTS - Text to Speech)
# ==========================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=rachel

# ==========================================
# DEEPGRAM (STT - Speech to Text alternativo)
# ==========================================
DEEPGRAM_API_KEY=your-deepgram-api-key

# ==========================================
# VAPI.AI (Llamadas en tiempo real)
# ==========================================
VAPI_API_KEY=your-vapi-api-key
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# ==========================================
# RETELL AI (Alternativa para llamadas)
# ==========================================
RETELL_API_KEY=your-retell-api-key
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# ==========================================
# TWILIO (Para integración de llamadas)
# ==========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# URLS PÚBLICAS (para webhooks)
# ==========================================
WEBHOOK_BASE_URL=https://your-domain.com
